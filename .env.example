# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored (see .gitignore line 34).
# Never commit secrets.

# ── Auth (existing) ───────────────────────────────────────
# Single shared password for the whole admin site.
# AUTH_PASSWORD is what the user types; AUTH_SECRET is the cookie value.
AUTH_PASSWORD=
AUTH_SECRET=

# ── QuickBooks Online ─────────────────────────────────────
# These four already exist in Vercel for the back-bar project (production).
# Pull them locally with: vercel env pull .env.production.local
#
# QB_CLIENT_ID, QB_CLIENT_SECRET — from Intuit Developer → MFC Dashboard
# QB_REFRESH_TOKEN, QB_REALM_ID — captured by /api/qb-callback when OAuth ran
QB_CLIENT_ID=
QB_CLIENT_SECRET=
QB_REFRESH_TOKEN=
QB_REALM_ID=

# ── MCP connector (/api/mcp) ──────────────────────────────
# Bearer tokens for the Back Bar MCP server. Generate long random strings
# (e.g. `openssl rand -hex 32`). If neither is set the endpoint is disabled.
#
# MCP_TOKEN          — full read + write access (Owner).
# MCP_READONLY_TOKEN — optional; read-only access (Operator).
MCP_TOKEN=
MCP_READONLY_TOKEN=

# ── GitHub Contents API (legacy ingredient editor) ────────
# Used by the existing /finances/ingredients editor, which commits JSON files
# back to the repo. Speed Rail does NOT use this — Speed Rail goes through
# Postgres. This stays for the legacy pages until ERP cutover.
GITHUB_PAT=

# ── Speed Rail (Back Bar ERP) ─────────────────────────────
# Postgres on Neon. Connection string from Neon dashboard
# (postgresql://user:pass@host/db?sslmode=require).
DATABASE_URL=

# Feature flag — gates the entire /erp/* tree.
# Set both vars to '1' together. The server-only flag (SPEED_RAIL_ENABLED)
# 404s the routes when off; the public-prefixed copy hides the nav link.
SPEED_RAIL_ENABLED=
NEXT_PUBLIC_SPEED_RAIL_ENABLED=
